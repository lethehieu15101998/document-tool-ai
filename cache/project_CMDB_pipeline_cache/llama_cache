1ec7\nt\u1eeb\n1 CI \nb\u1ea5t \nk\u1ef3\nt\u1edbi \n1 \nho\n\u1eb7c \nnhi\n\u1ec1u \nCIs \nkh\u00e1\nc \nth\u00e0\nnh \nc\u00f4n\ng \ns\u1eed\nd\n\u1ee5\nng\u00a0\nG\n\u1ee3i \n\u00fd \nm\n\u1ed1i \nq\nu\na\nn \nh\n\u1ec7\n\u0110\u0103\nng \nnh\n\u1eadp, \ntruy \nc\u1eadp \nmo\ndul\ne \nCM\nDB, \nm\u1edf\nchi \nti\u1ebft \nth\u00f4\nng \ntin \n1 CI \nthe\no \nm\u00f4 \nt\u1ea3\nt\u1ea1i \nUS \nCM\nDB-\n742\n, \nclic\nk \nTAB \nC\u00e1c \nm\u1ed1i \nqua\nn \nh\u1ec7\n(Rel\natio\nnsh\nip)\u00a0\u00a0\nUser \u0111\u01b0\u1ee3c ph\u00e2n quy\u1ec1n ch\u1ec9nh \ns\u1eeda CI\nC\u00e1c CI \u0111\u01b0\u1ee3c ch\u1ecdn \u0111\u1ec3 t\u1ea1o \nquan h\u1ec7 ch\u01b0a c\u00f3 m\u1ed1i quan h\u1ec7\nn\u00e0o v\u1edbi CI hi\u1ec7n t\u1ea1i tr\u01b0\u1edbc \u0111\u00f3.\nStep 1: M\u00e0n h\u00ecnh TAB C\u00e1c \nm\u1ed1i quan h\u1ec7\n(Relationship) hi\u1ec3n th\u1ecb\nv\u1edbi \u0111\u1ea7y \u0111\u1ee7 c\u00e1c th\u00e0nh \nph\u1ea7n m\u00f4 t\u1ea3 t\u1ea1i 3.1 >> \nClick button Th\u00eam quan \nh\u1ec7 / Add Relationship.\nStep 2: C\u1eeda s\u1ed5 Th\u00eam \nquan h\u1ec7 / Add \nRelationship hi\u1ec3n th\u1ecb, \nch\u1ecdn G\u1ee3i \u00fd m\u1ed1i quan h\u1ec7\nt\u01b0\u01a1ng \u1ee9ng v\u1edbi CI Type \nkh\u00e1c,\u00a0ch\u1ecdn b\u1ea5t k\u1ef3 1 quan \nh\u1ec7 g\u1ee3i \u00fd.\nStep 3: Danh s\u00e1ch CI hi\u1ec3n \nth\u1ecb tr\u00ean l\u01b0\u1edbi d\u1eef li\u1ec7u hi\u1ec3n \nth\u1ecb c\u00e1c CI thu\u1ed9c CI Type \n\u0111\u01b0\u1ee3c c\u1ea5u h\u00ecnh quan h\u1ec7\ntr\u01b0\u1edbc \u0111\u00f3 khi khai b\u00e1o CI \nType c\u1ee7a CI hi\u1ec7n t\u1ea1i.\nStep 4: T\u1ea1i danh s\u00e1ch CIs \nhi\u1ec3n th\u1ecb th\u1ef1c hi\u1ec7n T\u00ecm \nki\u1ebfm CI b\u1ea5t k\u00ec th\u00e0nh \nc\u00f4ng, sau \u0111\u00f3 Select 1 \nho\u1eb7c nhi\u1ec1u CI trong danh \ns\u00e1ch hi\u1ec3n th\u1ecb, click Th\u00eam \nm\u1edbi quan h\u1ec7 / Add.\nStep 5: Hi\u1ec3n th\u1ecb th\u00f4ng b\u00e1o \n\"T\u1ea1o quan h\u1ec7 th\u00e0nh \nc\u00f4ng.\". M\u00e0n h\u00ecnh TAB C\u00e1c \nm\u1ed1i quan h\u1ec7\n(Relationship) hi\u1ec3n th\u1ecb\nc\u00e1c quan h\u1ec7 (t\u00ean quan h\u1ec7\nl\u00e0 t\u00ean m\u1ed1i quan h\u1ec7 \u0111\u00e3 g\u1ee3i \n\u00fd t\u1ea1i Step 2) v\u1eeba kh\u1edfi t\u1ea1o \nt\u1eeb CI hi\u1ec7n t\u1ea1i t\u1edbi c\u00e1c CI \u0111\u00e3 \nch\u1ecdn t\u1ea1i Step 4.\nTh\u00eam m\u1edbi m\u1ed1i quan h\u1ec7 th\u00e0nh \nc\u00f4ng, c\u00e1c m\u1ed1i quan h\u1ec7 hi\u1ec3n \nth\u1ecb t\u1ea1i TAB Relationship c\u1ee7a CI \nhi\u1ec7n t\u1ea1i \u0111ang kh\u1edfi t\u1ea1o \nrelationship.\nT\u1ea1i c\u00e1c CI \u0111\u01b0\u1ee3c t\u1ea1o quan h\u1ec7\nt\u1edbi CI hi\u1ec7n t\u1ea1i hi\u1ec3n th\u1ecb c\u00e1c m\u1ed1i \nquan h\u1ec7 ngh\u1ecbch \u0111\u1ea3o v\u1edbi CI \nhi\u1ec7n t\u1ea1i.", "mimetype": "text/plain", "start_char_idx": 0, "end_char_idx": 1706, "metadata_seperator": "\n", "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, "__type__": "1"}, {"__data__": {"id_": "ebb0bf48-ebd5-49ec-a851-61f70ecd498d", "embedding": [-0.07146760076284409, 0.10654430836439133, -0.03659788891673088, -0.011310947127640247, 0.003565302351489663, -0.032675787806510925, -0.040422674268484116, -0.014047397300601006, -0.014957010746002197, -0.0021902574226260185, 0.055499956011772156, -0.07164578884840012, 0.025075577199459076, -0.02690458483994007, 0.08263885974884033, 0.047712258994579315, -0.021851256489753723, -0.016122255474328995, -0.015284302644431591, 0.010566494427621365, 0.007240673527121544, -0.008238965645432472, -0.03170154243707657, -0.011285615153610706, 0.00687786377966404, 0.03216871991753578, -0.012973926030099392, -0.055169783532619476, 0.005821073427796364, -0.16201043128967285, 0.0033104654867202044, 0.05822588503360748, 0.038747355341911316, 0.0014758463948965073, 0.04877711087465286, -0.040569815784692764, 0.0082334503531456, -0.018133046105504036, -0.021104060113430023, -0.009640459902584553, 0.058578379452228546, -0.001604702090844512, 0.0018704511458054185, 0.010824257507920265, 0.08037